{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ]
  },
  "extraKnownMarketplaces": {
    "zycck-mods": {
      "source": {
        "source": "github",
        "repo": "zycck/claude-mods"
      }
    },
    "reifen01-mods": {
      "source": {
        "source": "github",
        "repo": "reifen01/claude-mods"
      }
    }
  },
  "enabledPlugins": {
    "plan-progress@zycck-mods": true,
    "token-weather@reifen01-mods": true
  }
}
